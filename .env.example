# Copie para .env.local e preencha. Nunca versione o .env.local.
# O dashboard funciona sem nada disto (usa JSON local + dados de exemplo);
# cada bloco preenchido liga uma peça a mais.

# ---------- Banco de dados ----------
# Opção A (EasyPanel/Hostinger ou qualquer Postgres): defina DATABASE_URL.
# Formato: postgres://USUARIO:SENHA@HOST:5432/BANCO
# No EasyPanel, use a connection string interna do serviço de Postgres.
# Rode uma vez o conteúdo de supabase/setup.sql para criar as tabelas.
DATABASE_URL=
# DATABASE_SSL=require   # só se o Postgres exigir TLS (managed externo)

# Opção B (Supabase): em vez de DATABASE_URL, use estas duas.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# ---------- Instagram (orgânico) ----------
# Usa "Instagram API with Instagram Login" — NÃO precisa de Página do Facebook.
# 1) No app do Instagram, converta a conta para Profissional (Business ou Creator)
# 2) Crie um app em https://developers.facebook.com e adicione o produto Instagram
# 3) Escopos: instagram_business_basic, instagram_business_manage_insights
# 4) Faça o Business Login e troque o token curto (1h) por um de 60 dias:
#    GET https://graph.instagram.com/access_token
#        ?grant_type=ig_exchange_token&client_secret=APP_SECRET&access_token=TOKEN_CURTO
# O IG_USER_ID sai de: GET https://graph.instagram.com/v25.0/me?fields=user_id
# Depois disso o dashboard renova o token sozinho e guarda o novo no banco.
IG_USER_ID=
IG_ACCESS_TOKEN=

# ---------- Tráfego pago (Meta Marketing API v25) ----------
# Token de System User da Business Manager com permissão ads_read.
META_AD_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=
# Opcional — qual action_type conta como lead. O padrão já é o evento do Pixel
# na landing page. Só mude se o seu funil for diferente.
# META_LEAD_ACTION_TYPE=offsite_conversion.fb_pixel_lead

# ---------- Login (usuário e senha) ----------
# Ativa o login do painel. Enquanto vazio, o dashboard fica ABERTO (útil em dev;
# defina em produção). Gere algo aleatório, ex.: openssl rand -hex 32
# Na primeira vez, abra /login e crie o primeiro usuário (vira admin).
AUTH_SECRET=

# ---------- Coleta automática ----------
# Protege /api/sync (a Vercel manda este valor no header Authorization).
# Gere algo aleatório, ex.: openssl rand -hex 32
CRON_SECRET=

# ---------- Fase 3: rastreio da landing page ----------
# URL da landing page (usada como padrão no gerador de UTMs).
LP_BASE_URL=

# Origens permitidas a chamar /api/track (CORS). Aceita VÁRIAS separadas por
# vírgula (temos duas landing pages). Use * apenas em teste.
# Ex.: https://calculadoraconsorcio.grupokrone.com.br,https://consorciobrunno.grupokrone.com.br
LP_ALLOWED_ORIGIN=

# Chave que a landing page envia junto do evento. Não é segredo forte (fica no
# navegador) — serve para descartar tráfego aleatório no endpoint.
TRACK_INGEST_KEY=

# Conversions API (CAPI) — envia Lead/Schedule pelo servidor, recuperando o
# sinal que o Pixel perde por bloqueio de navegador/ATT.
# Dataset ID = o antigo "Pixel ID" (Events Manager > Configurações do dataset).
META_DATASET_ID=
META_CAPI_TOKEN=
# Opcional: enquanto testa, cole o código do Test Events do Events Manager.
# META_CAPI_TEST_EVENT_CODE=

# GA4 Measurement Protocol (eventos server-side)
# Admin > Fluxos de dados > seu fluxo: "ID da métrica" (G-XXXX) e crie um
# "Segredo da API" em Measurement Protocol API secrets.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# ---------- Opcional ----------
# A versão da API fica fixada de propósito. Só mude depois de ler o changelog.
# META_API_VERSION=v25.0
